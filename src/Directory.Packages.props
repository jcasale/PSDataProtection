<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" />
    <PackageVersion Include="MinVer" Version="8.1.0-alpha.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>
</Project>